<?xml version="1.0" encoding="UTF-8"?>
<!--
    WHAT IS THIS FILE?
    pom.xml stands for "Project Object Model XML". It's like a recipe for your project.
    It tells Maven:
    1. What Java version to use
    2. What libraries (dependencies) to download
    3. How to build/package the project

    WHY do we need it?
    Without this file, Maven wouldn't know what libraries your code needs.
    When you run "mvn clean install", Maven reads this file, downloads all the
    dependencies, compiles your code, and packages it into a .jar file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        MODEL VERSION: Always 4.0.0 for Maven 2/3/4 projects.
        This is the POM schema version, not your app version.
    -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        PARENT POM: spring-boot-starter-parent
        WHY? Spring Boot provides a "parent" that includes:
        - Default configurations for all Spring libraries
        - Plugin management (compiler, packaging)
        - Dependency version management (you don't need to specify versions for Spring libs)
        
        Think of it as: "Hey Spring, manage the versions for me so I don't have to."
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version> <!-- Spring Boot 3.2.5 (latest stable for this project) -->
        <relativePath/> <!-- Look for parent in Maven repository, not local file system -->
    </parent>

    <!--
        GROUP ID + ARTIFACT ID + VERSION = Your project's unique address in the Maven world.
        GROUP ID: com.smartcare.smartclinic (your company.package)
        ARTIFACT ID: smart-clinic-management (your project name)
        VERSION: 1.0.0 (first release)
    -->
    <groupId>com.smartcare</groupId>
    <artifactId>smart-clinic-management</artifactId>
    <version>1.0.0</version>
    <name>Smart Clinic Management System</name>
    <description>A full-stack clinic management system built with Spring Boot</description>

    <!--
        JAVA VERSION: We're using Java 17.
        WHY 17? It's an LTS (Long Term Support) release, and Spring Boot 3.x requires Java 17+.
    -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!--
        DEPENDENCIES: These are the libraries your project needs.
        Each <dependency> is like adding a tool to your toolbox.
    -->
    <dependencies>

        <!--
            1. SPRING BOOT STARTER WEB
            WHY? This gives you everything for building web applications:
            - Embedded Tomcat server (runs your app without installing a separate server)
            - Spring MVC (handles HTTP requests and routes them to your controllers)
            - REST API support (JSON serialization/deserialization)
            - Validation support
            
            WITHOUT THIS: You'd need to manually configure a web server, 
            set up servlets, handle HTTP parsing... nightmare.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            2. SPRING BOOT STARTER DATA JPA
            WHY? JPA (Java Persistence API) is the standard for talking to databases in Java.
            Hibernate is the implementation we're using.
            
            This gives you:
            - Entity mapping (Java class = database table)
            - Repository pattern (CRUD operations without writing SQL)
            - Transaction management
            
            WITHOUT THIS: You'd write raw JDBC code like:
            Connection conn = DriverManager.getConnection(...);
            PreparedStatement stmt = conn.prepareStatement("SELECT * FROM doctors");
            ... which is error-prone and verbose.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            SPRING BOOT STARTER VALIDATION
            Gives us @NotNull, @Email, @Size, @NotBlank etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            3. MYSQL CONNECTOR/J
            WHY? This is the JDBC driver that lets Java talk to MySQL databases.
            It translates Java method calls into MySQL protocol commands.
            
            WITHOUT THIS: Java wouldn't know how to communicate with MySQL.
            It's like having a phone but no SIM card.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope> <!-- "runtime" means we only need it when running, not compiling -->
        </dependency>

        <!--
            4. SPRING BOOT STARTER DATA MONGODB
            WHY? MongoDB is our NoSQL database for prescriptions.
            Prescriptions are flexible (different medicines, dosages, notes)
            so a document database like MongoDB makes more sense than rigid SQL tables.
            
            This gives you:
            - MongoTemplate (like JPA but for MongoDB)
            - Repository pattern for MongoDB
            - Automatic object-to-document mapping
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!--
            5. SPRING BOOT STARTER SECURITY
            WHY? Security is NON-NEGOTIABLE for a healthcare app!
            This gives you:
            - Authentication (who are you?)
            - Authorization (what can you do?)
            - Protection against common attacks (CSRF, XSS)
            - Password hashing
            
            We'll add JWT on top of this for token-based auth.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            6. SPRING BOOT STARTER THYMELEAF
            WHY? Thymeleaf is a template engine that lets you create dynamic HTML pages.
            It's server-side rendering — the HTML is generated on the server and sent to the browser.
            
            USE CASE: Our login pages, admin dashboard, doctor portal, patient portal.
            Thymeleaf lets you embed Java logic in HTML like:
            <p th:text="${doctor.name}">Doctor Name</p>
            
            WITHOUT THIS: You'd need a separate frontend framework (React, Angular)
            which adds complexity for a capstone project.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            7. SPRING SECURITY THYMELEAF DIALECT
            WHY? This lets you use security tags in Thymeleaf templates.
            Example: <div sec:authorize="hasRole('ADMIN')">Only admins see this</div>
            
            WITHOUT THIS: You'd need to check roles in Java code and pass flags to templates.
        -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!--
            8. JWT (JSON WEB TOKEN) LIBRARY
            WHY? JWT is the industry standard for API authentication.
            How it works:
            1. User logs in with username/password
            2. Server validates credentials and creates a JWT token
            3. Server sends token back to client
            4. Client includes token in every subsequent request
            5. Server validates token (no need to check database each time)
            
            Benefits:
            - Stateless (server doesn't store session data)
            - Scalable (any server can validate the token)
            - Secure (tokens are signed with a secret key)
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            9. LOMBOK
            WHY? Lombok eliminates boilerplate code (getters, setters, constructors, etc.)
            
            WITHOUT Lombok:
            @Entity
            public class Doctor {
                private Long id;
                private String name;
                private String specialization;
                
                public Doctor() {} // constructor
                public Doctor(String name, String specialization) { ... } // param constructor
                public Long getId() { return id; } // getter
                public void setId(Long id) { this.id = id; } // setter
                // ... 20 more lines for a simple class
            }
            
            WITH Lombok:
            @Entity
            @Data  // Generates getters, setters, toString, equals, hashCode
            @NoArgsConstructor  // Generates no-args constructor
            @AllArgsConstructor  // Generates all-args constructor
            public class Doctor {
                private Long id;
                private String name;
                private String specialization;
            }
            // Clean, readable, and professional!
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional> <!-- "optional" means downstream projects don't need it -->
        </dependency>

        <!--
            10. SPRING BOOT STARTER TEST
            WHY? Testing is essential! This gives you:
            - JUnit 5 (test framework)
            - Mockito (mock external dependencies)
            - Spring Boot Test (test Spring context)
            - AssertJ (better assertions)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            11. SPRING SECURITY TEST
            WHY? Testing security is tricky. This gives you tools to:
            - Mock authenticated users
            - Test role-based access
            - Verify security configurations
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
        BUILD PLUGINS: These control how Maven builds your project.
    -->
    <build>
        <plugins>
            <!--
                SPRING BOOT MAVEN PLUGIN
                WHY? This plugin does two critical things:
                1. mvn spring-boot:run — runs your app directly
                2. mvn package — creates an executable .jar file
                
                The .jar file includes ALL dependencies (fat jar),
                so you can run it anywhere with just: java -jar app.jar
                
                WITHOUT THIS: You'd need to manually manage classpath
                and deployment to an external Tomcat server.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclude Lombok from the final jar (it's only needed at compile time) -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
